# ==============================================================================
# Harness CLI Environment Configuration (.env.example)
#
# 사용법:
#   1) 이 파일을 .env 로 복사합니다:
#      cp .env.example .env
#   2) 또는 전역 설정을 위해 ~/.harness/.env 로 복사합니다:
#      mkdir -p ~/.harness && cp .env.example ~/.harness/.env
#   3) 본인이 사용하는 LLM 환경(OpenAI, Ollama, vLLM 등)의 주석을 풀고 설정하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI 공식 API (가장 간편하며 어디서든 실시간 추론 가능)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. 로컬 Ollama (로컬 GPU/CPU 무료 실행, API 키 불필요)
#    실행 예시: ollama run llama3.2:3b
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# HARNESS_MODEL=openai/llama3.2:3b
# OPENAI_API_KEY=ollama-local

# ------------------------------------------------------------------------------
# 3. vLLM / SGLang / 연구실 On-Premise GPU 서버
# ------------------------------------------------------------------------------
# HARNESS_API_BASE=http://your-sglang-host:8000/v1
# HARNESS_MODEL=openai/Inferact/Qwen3.8-Flash-Next-NVFP4
# OPENAI_API_KEY=onprem-placeholder

# ------------------------------------------------------------------------------
# 4. 하네스 CLI 기본 동작 옵션
# ------------------------------------------------------------------------------
# HARNESS_SYSTEM=confusion_contrast    # 기본 메모리 블록 (confusion_contrast, knn_top6, cue_bank, no_memory 등)
# HARNESS_TIMEOUT=30                  # LLM 응답 대기 시간(초)
